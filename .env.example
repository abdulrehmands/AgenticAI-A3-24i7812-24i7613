# GitHub — classic PAT with repo + workflow
GITHUB_TOKEN=github_pat_placeholder
GITHUB_REPO=your-username/launchmind-your-group
GITHUB_DEFAULT_BRANCH=main
ENGINEER_BRANCH=agent-landing-page

# Slack bot (chat:write, channels:read, channels:join)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL=#launches

# SendGrid (verified sender must match SENDGRID_FROM_EMAIL)
SENDGRID_API_KEY=SG.placeholder
SENDGRID_FROM_EMAIL=verified@yourdomain.com
MARKETING_TO_EMAIL=your-inbox@example.com

# LLM — at least one provider required
OPENAI_API_KEY=sk-placeholder
OPENAI_MODEL=gpt-4o-mini

# Optional: use Anthropic for CEO only (bonus: multi-provider)
# ANTHROPIC_API_KEY=sk-ant-placeholder
# CEO_LLM_PROVIDER=anthropic

# Optional QA agent (set true for 3-person groups or bonus)
ENABLE_QA=true

# Startup idea (optional; can pass as CLI arg to main.py)
# STARTUP_IDEA=Your concrete startup idea here

# Set to 0/false to silence per-message bus traces (demo video usually wants traces on)
# LAUNCHMIND_TRACE_BUS=1

# Optional: Redis-backed message bus (lists + PUBLISH on channel {prefix}:bus). Omit to use in-memory dict.
# LAUNCHMIND_REDIS_URL=redis://localhost:6379/0
# LAUNCHMIND_REDIS_PREFIX=launchmind

# ---------------------------------------------------------------------------
# CEO review / revision limits (main.py)
# Each value = max total attempts (first delivery + revision rounds) before the run fails.
# Minimum enforced in code: 1. Increase if the CEO LLM often rejects first drafts.
# ---------------------------------------------------------------------------
LAUNCHMIND_MAX_PRODUCT_ATTEMPTS=4
LAUNCHMIND_MAX_ENGINEER_ATTEMPTS=5
LAUNCHMIND_MAX_MARKETING_ATTEMPTS=3
